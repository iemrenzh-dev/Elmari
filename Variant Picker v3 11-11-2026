{% comment %}
  Unified Variant Picker + Size Guide Drawer + Smart Upsells (UNIQUE ID FIX)
  - Fixed 'X' close button and Upsells breaking due to duplicate hidden DOM elements.
  - Appended {{ section.id }} to all Drawer and Upsell elements so they never conflict.
{% endcomment %}

<!-- ========================================== -->
<!-- 1. UNIFIED CSS STYLES                      -->
<!-- ========================================== -->
<style>
  /* --- VARIANT PICKER STYLES --- */
  variant-radios { display: flex !important; flex-direction: column !important; }
  .variant-input-wrapper.opt-is-color { order: -1; }
  .variant-input-wrapper > legend.form__label {
    position: static !important; width: auto !important; height: auto !important;
    margin: 0 0 0.6rem !important; padding: 0 !important; overflow: visible !important;
    clip: auto !important; clip-path: none !important; white-space: normal !important;
    display: block !important; font-size: 1.3rem; font-weight: 500;
  }
  .color__swatch {
    width: 26px !important; height: 26px !important; border-radius: 50% !important;
    clip-path: none !important; -webkit-clip-path: none !important;
    mask: none !important; -webkit-mask: none !important;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease, margin 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
    position: relative; overflow: visible !important; cursor: pointer; z-index: 1; border: 1px solid #ccc !important;
  }
  .variant-input-wrapper input:checked + label.color__swatch {
    box-shadow: 0 0 0 2px #fff, 0 0 0 3px #d1d1d1 !important; transform: scale(1.25) !important;
    margin: 0 8px !important; z-index: 10 !important; border-color: transparent !important;
  }
  .variant-input-wrapper input:checked + label:not(.color__swatch) {
    background-color: #111 !important; border-color: #111 !important; color: #fff !important; font-weight: 600;
  }
  .variant-input-wrapper label::before, .variant-input-wrapper label::after { display: none !important; content: none !important; }
  .variant-input-wrapper label.state-oos { opacity: 0.3; cursor: not-allowed; }
  .variant-input-wrapper input:disabled + label { pointer-events: none; }
  .variant-input-wrapper input:disabled + label.color__swatch { border-radius: 50% !important; transform: none !important; }
  .variant-input-wrapper label:not(.color__swatch).state-oos { text-decoration: line-through; }
  .variant-input-wrapper .color__swatch.state-oos::after {
    display: block !important; content: "" !important; position: absolute !important; top: 50% !important;
    left: -10% !important; width: 120% !important; height: 1.5px !important; background: #555 !important;
    transform: rotate(-45deg) !important; z-index: 5 !important; pointer-events: none !important;
  }
  .size-guide-trigger {
    display: inline-flex; align-items: center; gap: 5px; background: none; border: none; box-shadow: none;
    padding: 8px 12px; margin-left: 5px; cursor: pointer; font-size: 1.2rem; font-weight: 400; color: #043254;
    text-decoration: underline; text-underline-offset: 3px; font-family: inherit; transition: opacity 0.2s ease;
  }
  .size-guide-trigger:hover { opacity: 0.7; }

  /* --- SIZE GUIDE DRAWER STYLES --- */
  .custom-drawer-overlay {
    position: fixed !important; top: 0 !important; left: 0 !important; width: 100vw !important; height: 100vh !important;
    background: rgba(0, 0, 0, 0.6) !important; backdrop-filter: blur(5px) !important; -webkit-backdrop-filter: blur(5px) !important;
    z-index: 2147483646 !important; opacity: 0; visibility: hidden; transition: all 0.3s ease;
  }
  .custom-drawer-overlay.is-open { opacity: 1 !important; visibility: visible !important; }
  .custom-size-drawer {
    position: fixed !important; top: 0 !important; right: -100%; width: 100%; max-width: 450px; height: 100vh !important;
    background: #ffffff !important; z-index: 2147483647 !important; box-shadow: -5px 0 20px rgba(0, 0, 0, 0.2) !important;
    transition: right 0.3s ease; display: flex; flex-direction: column; overflow-y: auto; font-family: inherit;
  }
  .custom-size-drawer.is-open { right: 0 !important; }
  .custom-size-drawer__header {
    display: flex; justify-content: space-between; align-items: center; padding: 15px 20px;
    border-bottom: 1px solid #eaeaea; position: sticky; top: 0; background: #ffffff; z-index: 2;
  }
  .custom-size-drawer__title-wrap { display: flex; align-items: center; gap: 10px; }
  .custom-size-drawer__title { margin: 0; font-size: 1.2rem; font-weight: 500; color: #043254; letter-spacing: 0.5px; }
  .custom-size-drawer__close { background: transparent; border: none; cursor: pointer; padding: 5px; display: flex; }
  .custom-size-drawer__close:hover { opacity: 0.7; }
  .custom-size-drawer__content { padding: 20px; }
  .custom-size-drawer__product-box { background-color: #FAF5F0; padding: 15px 20px; border-radius: 8px; margin-bottom: 15px; }
  .custom-size-drawer__product-box h4 { margin: 0 0 8px 0; font-size: 1.05rem; color: #043254; font-weight: 600; }
  .custom-size-drawer__product-box p { margin: 0; font-size: 0.9rem; color: #043254; line-height: 1.3; }
  .custom-size-drawer__zoom-hint { text-align: center; font-size: 0.85rem; color: #666; margin-bottom: 15px; display: flex; align-items: center; justify-content: center; gap: 5px; }
  .zoom-image-container { position: relative; overflow: hidden; cursor: zoom-in; touch-action: none; border-radius: 4px; }
  .zoom-image { width: 100%; height: auto; display: block; transition: transform 0.2s ease; transform-origin: center center; }
  .zoom-image.is-zoomed { transform: scale(2.5); cursor: zoom-out; }
  .custom-size-drawer__help { margin-top: 40px; margin-bottom: 20px; text-align: center; }
  .help-title { color: #043254; font-size: 1.1rem; font-weight: 500; margin-bottom: 20px; text-align: center; }
  .help-icons-row { display: flex; justify-content: center; gap: 40px; }
  .help-link { display: flex; flex-direction: column; align-items: center; text-decoration: none; color: #043254; transition: opacity 0.2s; }
  .help-link:hover { opacity: 0.7; }
  .help-link svg { width: 32px; height: 32px; margin-bottom: 8px; }
  .help-link span { font-size: 0.95rem; font-weight: 400; }
  
  /* UPSELL STYLES */
  .drawer-upsell-section { border-top: 1px solid #eaeaea; margin-top: 30px; padding-top: 10px; }
  .drawer-upsell-list { display: flex; flex-direction: column; gap: 15px; }
  .drawer-upsell-item { display: flex; gap: 15px; align-items: center; background: #fdfdfd; border: 1px solid #eaeaea; padding: 10px; border-radius: 8px; text-decoration: none; color: inherit; transition: border 0.2s; }
  .drawer-upsell-item:hover { border-color: #043254; }
  .drawer-upsell-img { width: 60px; height: 80px; object-fit: cover; border-radius: 4px; background: #f4f4f4; }
  .drawer-upsell-info { flex: 1; display: flex; flex-direction: column; gap: 5px; }
  .drawer-upsell-info h5 { margin: 0; font-size: 0.95rem; color: #043254; font-weight: 500; line-height: 1.2; }
  .drawer-upsell-btn { align-self: flex-start; font-size: 0.8rem; background: #043254; color: #fff; padding: 4px 10px; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.5px; }
</style>

<!-- ========================================== -->
<!-- 2. VARIANT PICKER HTML                     -->
<!-- ========================================== -->
{%- unless product.has_only_default_variant -%}
  {%- if block.settings.picker_type == 'button' -%}
    <variant-radios
      id="v-radios-{{ section.id }}"
      class="no-js-hidden"
      data-section="{{ section.id }}"
      data-url="{{ product.url }}"
      {{ block.shopify_attributes }}
    >
      {%- for option in product.options_with_values -%}
        {%- assign is_color = false -%}
        {%- assign is_size = false -%}
        {%- assign dn_name = option.name | downcase -%}
        {%- if dn_name contains 'color' or dn_name contains 'colour' -%}
          {%- assign is_color = true -%}
        {%- endif -%}
        {%- if dn_name contains 'size' -%}
          {%- assign is_size = true -%}
        {%- endif -%}
        {%- assign opt_index = forloop.index0 -%}

        <fieldset class="js product-form__input variant-input-wrapper{% if is_color %} opt-is-color{% endif %}" data-index="{{ opt_index }}" data-is-size="{{ is_size }}" data-option-name="{{ option.name | handle }}">
          <legend class="form__label">{{ option.name }}: <span class="js-label-text"></span></legend>

          {%- for value in option.values -%}
            {%- assign available_in_stock = false -%}
            {%- for variant in product.variants -%}
              {%- if variant.options[opt_index] == value and variant.available -%}
                {%- assign available_in_stock = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}

            <input
              type="radio"
              id="{{ section.id }}-{{ option.name }}-{{ forloop.index0 }}"
              name="{{ option.name }}-{{ section.id }}"
              value="{{ value | escape }}"
              data-value-handle="{{ value | handle }}"
              form="{{ product_form_id }}"
              {% unless available_in_stock %}disabled{% endunless %}
            >
            {%- if is_color -%}
              {%- assign color_file = value | handle | append: '.png' -%}
              {%- assign fallback = value | split: ' ' | last | handle -%}
              <label for="{{ section.id }}-{{ option.name }}-{{ forloop.index0 }}" 
                     class="color__swatch {% unless available_in_stock %}state-oos{% endunless %}" 
                     style="background-color: {{ fallback }} !important; {% if images[color_file] != blank %}background-image: url({{ color_file | file_img_url: '50x50' }}) !important;{% endif %}"
                     title="{{ value }}"
              ></label>
            {%- else -%}
              <label for="{{ section.id }}-{{ option.name }}-{{ forloop.index0 }}" class="{% unless available_in_stock %}state-oos{% endunless %}">
                {{ value }}
              </label>
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%} APPEND SIZE GUIDE TRIGGER AFTER SIZES {%- endcomment -%}
          {%- if is_size and product.metafields.custom.size_chart -%}
            <button type="button" class="size-guide-trigger" onclick="event.preventDefault(); window.openSizeChartDrawer('{{ section.id }}');">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21.17 6.83a4 4 0 0 0-5.66 0L4 18.34a4 4 0 0 0 5.66 5.66l11.51-11.51a4 4 0 0 0 0-5.66z"></path>
                <line x1="17.66" y1="10.34" x2="19.07" y2="11.76"></line>
                <line x1="14.83" y1="13.17" x2="16.24" y2="14.59"></line>
                <line x1="12" y1="16" x2="13.41" y2="17.41"></line>
                <line x1="9.17" y1="18.83" x2="10.59" y2="20.24"></line>
              </svg>
              <span>Size guide</span>
            </button>
          {%- endif -%}

        </fieldset>
      {%- endfor -%}

      <script type="application/json" id="V-Data-{{ section.id }}">
        {{ product.variants | json }}
      </script>
    </variant-radios>
  {%- endif -%}
{%- endunless -%}


<!-- ========================================== -->
<!-- 3. SIZE GUIDE DRAWER HTML (Unique IDs)     -->
<!-- ========================================== -->
{% if product.metafields.custom.size_chart %}
  <div id="SizeChartOverlay-{{ section.id }}" class="custom-drawer-overlay" onclick="window.closeSizeChartDrawer('{{ section.id }}')"></div>
  <div id="SizeChartDrawer-{{ section.id }}" class="custom-size-drawer">
    
    <div class="custom-size-drawer__header">
      <div class="custom-size-drawer__title-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#043254" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21.17 6.83a4 4 0 0 0-5.66 0L4 18.34a4 4 0 0 0 5.66 5.66l11.51-11.51a4 4 0 0 0 0-5.66z"></path>
          <line x1="17.66" y1="10.34" x2="19.07" y2="11.76"></line>
          <line x1="14.83" y1="13.17" x2="16.24" y2="14.59"></line>
          <line x1="12" y1="16" x2="13.41" y2="17.41"></line>
          <line x1="9.17" y1="18.83" x2="10.59" y2="20.24"></line>
